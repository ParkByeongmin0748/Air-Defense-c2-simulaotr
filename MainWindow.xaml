<Window x:Class="AirDefenseC2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AirDefenseC2.ViewModels"
        xmlns:v="clr-namespace:AirDefenseC2.Views"
        xmlns:m="clr-namespace:AirDefenseC2.Models"
        Title="Air Defense C2 Simulator"
        Width="1440" Height="940"
        MinWidth="1200" MinHeight="800"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Consolas, Malgun Gothic"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 상단 바 ================= -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AIR DEFENSE C2" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text=" · 방공 지휘통제 시뮬레이터" FontSize="14" Foreground="{StaticResource DimBrush}"
                           VerticalAlignment="Bottom" Margin="0,0,24,1"/>

                <TextBlock Foreground="{StaticResource GreenBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Run Text="● 추적"/> <Run Text="{Binding TrackCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource AmberBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Run Text="● 경고"/> <Run Text="{Binding WarningCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource RedBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Run Text="● 위협"/> <Run Text="{Binding ThreatCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource FriendlyBrush}" VerticalAlignment="Center">
                    <Run Text="✕ 격추"/> <Run Text="{Binding KillCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="표적 투입" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button Style="{StaticResource DarkButton}" Content="+ 미사일" Foreground="{StaticResource RedBrush}"
                        Command="{Binding SpawnCommand}" CommandParameter="{x:Static m:TargetType.Missile}"/>
                <Button Style="{StaticResource DarkButton}" Content="+ 드론" Foreground="{StaticResource AmberBrush}"
                        Command="{Binding SpawnCommand}" CommandParameter="{x:Static m:TargetType.Drone}"/>
                <Button Style="{StaticResource DarkButton}" Content="+ 항공기" Foreground="{StaticResource GreenBrush}"
                        Command="{Binding SpawnCommand}" CommandParameter="{x:Static m:TargetType.Aircraft}"/>

                <Rectangle Width="1" Fill="{StaticResource PanelBorder}" Margin="12,2,6,2"/>

                <ToggleButton Style="{StaticResource DarkToggle}" IsChecked="{Binding AutoEngage}"
                              Content="{Binding AutoEngageText}"/>
                <Button Style="{StaticResource DarkButton}" Content="{Binding TimeScaleText}"
                        Command="{Binding CycleTimeScaleCommand}"/>
                <Button Style="{StaticResource DarkButton}" Content="{Binding RunButtonText}" MinWidth="96"
                        Command="{Binding ToggleRunCommand}"/>
                <Button Style="{StaticResource DarkButton}" Content="⟲ 초기화"
                        Command="{Binding ResetCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ================= RADAR SCOPE ================= -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="RADAR SCOPE" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="{Binding RadarInfoText}" Style="{StaticResource DimText}" HorizontalAlignment="Right"/>
                </Grid>

                <v:RadarScopeView Grid.Row="1" Margin="4,6,4,4"/>

                <!-- 범례 -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
                    <WrapPanel.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                            <Setter Property="Margin" Value="4,0,14,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Path Data="M 0,-10 L 5,7 L 0,3.5 L -5,7 Z" Fill="{StaticResource DimBrush}" Stretch="Uniform" Width="10" Height="12"/>
                    <TextBlock Text="미사일"/>
                    <Path Data="M 0,-8 L 8,0 L 0,8 L -8,0 Z" Stroke="{StaticResource DimBrush}" Stretch="Uniform" Width="11" Height="11"/>
                    <TextBlock Text="드론"/>
                    <Path Data="M 0,-10 L 1.6,-6 L 1.6,-2 L 10,3 L 10,5.2 L 1.6,2.6 L 1.2,7 L 4,9 L 4,10.6 L 0,9.6 L -4,10.6 L -4,9 L -1.2,7 L -1.6,2.6 L -10,5.2 L -10,3 L -1.6,-2 L -1.6,-6 Z"
                          Fill="{StaticResource DimBrush}" Stretch="Uniform" Width="13" Height="13"/>
                    <TextBlock Text="항공기"/>
                    <Ellipse Width="10" Height="10" Stroke="{StaticResource DimBrush}"/>
                    <TextBlock Text="미식별"/>
                    <Rectangle Width="12" Height="9" Stroke="{StaticResource FriendlyBrush}" Fill="#12303D"/>
                    <TextBlock Text="발사대"/>
                    <Ellipse Width="7" Height="7" Fill="White"/>
                    <TextBlock Text="요격미사일"/>
                    <TextBlock Text="■" Foreground="{StaticResource RedBrush}" Margin="0"/>
                    <TextBlock Text="HIGH"/>
                    <TextBlock Text="■" Foreground="{StaticResource AmberBrush}" Margin="0"/>
                    <TextBlock Text="MID"/>
                    <TextBlock Text="■" Foreground="{StaticResource GreenBrush}" Margin="0"/>
                    <TextBlock Text="LOW"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================= 오른쪽 패널 ================= -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TARGET LIST -->
            <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="TARGET LIST" Style="{StaticResource PanelTitle}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource DimText}">
                            <Run Text="누적 탐지"/> <Run Text="{Binding DetectedTotal, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="7,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="1" Text="종류" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="2" Text="방위" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="3" Text="거리" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="4" Text="고도" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="5" Text="속도" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="6" Text="위협" Style="{StaticResource DimText}"/>
                        <TextBlock Grid.Column="7" Text="상태" Style="{StaticResource DimText}"/>
                    </Grid>

                    <ListBox Grid.Row="2" Style="{StaticResource DarkListBox}"
                             ItemsSource="{Binding Targets}"
                             SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Target}">
                                <Grid Height="26">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Bearing, StringFormat={}{0:000}°}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Range, StringFormat={}{0:0.0}km}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding AltitudeText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SpeedText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding ThreatText}" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="탐지된 표적 없음 - 레이더 탐색 중..." Style="{StaticResource DimText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Targets.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </Border>

            <!-- SELECTED TARGET -->
            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELECTED TARGET" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>

                    <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                        <UniformGrid.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </UniformGrid.Resources>
                        <StackPanel>
                            <TextBlock Text="ID" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.Id, FallbackValue=-}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource SelectBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="종류" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.TypeName, FallbackValue=-}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="상태" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.StatusText, FallbackValue=-}" FontSize="14"
                                       Foreground="{Binding SelectedTarget.Status, Converter={StaticResource StatusBrush}, FallbackValue={StaticResource TextBrush}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="위협도" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.ThreatText, FallbackValue=-}" FontSize="14" FontWeight="Bold"
                                       Foreground="{Binding SelectedTarget.Threat, Converter={StaticResource ThreatBrush}, FallbackValue={StaticResource TextBrush}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="방위 / 거리" Style="{StaticResource DimText}"/>
                            <TextBlock FontSize="13">
                                <Run Text="{Binding SelectedTarget.Bearing, Mode=OneWay, StringFormat={}{0:000}°, FallbackValue=-}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding SelectedTarget.Range, Mode=OneWay, StringFormat={}{0:0.0}km, FallbackValue=-}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="고도" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.AltitudeText, FallbackValue=-}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="속도" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.SpeedText, FallbackValue=-}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="할당 발사대" Style="{StaticResource DimText}"/>
                            <TextBlock Text="{Binding SelectedTarget.AssignedLauncher.Id, FallbackValue=-, TargetNullValue=-}" FontSize="13"
                                       Foreground="{StaticResource FriendlyBrush}"/>
                        </StackPanel>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource DarkButton}" Margin="0" Height="34"
                                Content="◎ 모의 요격 (ENGAGE)" FontWeight="Bold"
                                Foreground="{StaticResource RedBrush}" BorderBrush="{StaticResource RedBrush}"
                                Command="{Binding EngageCommand}"/>
                        <Button Grid.Column="1" Style="{StaticResource DarkButton}" Height="34"
                                Content="선택 해제" Command="{Binding ClearSelectionCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- WEAPON STATUS -->
            <Border Grid.Row="4" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="WEAPON STATUS" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Launchers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Launcher}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Height="10" Margin="0,0,10,0">
                                        <ProgressBar Maximum="{Binding MaxAmmo}" Value="{Binding Ammo, Mode=OneWay}"
                                                     Background="#0E1511" BorderBrush="{StaticResource PanelBorder}"
                                                     Foreground="{StaticResource FriendlyBrush}"/>
                                        <ProgressBar Maximum="1" Value="{Binding ReloadProgress, Mode=OneWay}"
                                                     Background="#0E1511" BorderBrush="{StaticResource PanelBorder}"
                                                     Foreground="{StaticResource AmberBrush}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:LauncherStatus.Reloading}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding AmmoText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontWeight="Bold"
                                               Foreground="{Binding Status, Converter={StaticResource LauncherBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= PROCESS ================= -->
        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PROCESS" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="탐지 → 식별 → 위협평가 → 무장할당 → 요격 → 결과" Style="{StaticResource DimText}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- 킬체인 단계 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ProcessSteps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:ProcessStep}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="›" FontSize="18" Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center" Margin="3,0"
                                           Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}"/>
                                <Border Grid.Column="1" CornerRadius="4" BorderThickness="1" Padding="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#101914"/>
                                            <Setter Property="BorderBrush" Value="#294335"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Done}">
                                                    <Setter Property="Background" Value="#1B3A27"/>
                                                    <Setter Property="BorderBrush" Value="#3E8A5A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Active}">
                                                    <Setter Property="Background" Value="#3A3216"/>
                                                    <Setter Property="BorderBrush" Value="#FFBE45"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Failed}">
                                                    <Setter Property="Background" Value="#3A1A18"/>
                                                    <Setter Property="BorderBrush" Value="#FF6258"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5E7366"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Done}">
                                                            <Setter Property="Foreground" Value="#65E891"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Active}">
                                                            <Setter Property="Foreground" Value="#FFBE45"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static m:StepState.Failed}">
                                                            <Setter Property="Foreground" Value="#FF6258"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Index, Mode=OneWay}"/><Run Text="."/>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Margin="0,8,0,8" Foreground="{StaticResource SelectBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="▶ 선택 표적:" Foreground="{StaticResource DimBrush}"/>
                    <Run Text="{Binding SelectedSummary, Mode=OneWay}"/>
                </TextBlock>

                <!-- 시뮬레이션 상태 -->
                <UniformGrid Grid.Row="3" Columns="4" Rows="2">
                    <UniformGrid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,0,8,4"/>
                        </Style>
                    </UniformGrid.Resources>
                    <StackPanel>
                        <TextBlock Text="시뮬레이션" Style="{StaticResource DimText}"/>
                        <TextBlock FontSize="13" FontWeight="Bold">
                            <Run Text="{Binding RunStateText, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="#65E891"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="Foreground" Value="#FFBE45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="{Binding SimTimeText, Mode=OneWay}" FontWeight="Normal"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource DimText}">
                            <Run Text="레이더 스캔 #"/><Run Text="{Binding ScanCount, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Height="10" Margin="0,4,0,0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}"
                                     Background="#0E1511" BorderBrush="{StaticResource PanelBorder}"
                                     Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="추적 / 교전 중" Style="{StaticResource DimText}"/>
                        <TextBlock FontSize="13">
                            <Run Text="{Binding TrackCount, Mode=OneWay}"/> <Run Text="/"/>
                            <Run Text="{Binding EngagingCount, Mode=OneWay}" Foreground="{StaticResource AmberBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="요격탄 발사 / 비행 중" Style="{StaticResource DimText}"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource FriendlyBrush}">
                            <Run Text="{Binding FiredCount, Mode=OneWay}"/> <Run Text="/"/>
                            <Run Text="{Binding InFlightCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="요격 성공" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding KillCount}" FontSize="13" Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="요격 실패" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding MissCount}" FontSize="13" Foreground="{StaticResource AmberBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="방어지역 침투" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding LeakCount}" FontSize="13" Foreground="{StaticResource RedBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="교전 모드" Style="{StaticResource DimText}"/>
                        <TextBlock FontSize="13">
                            <Run Text="{Binding AutoEngageText, Mode=OneWay}"/> <Run Text="·"/>
                            <Run Text="{Binding TimeScaleText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ================= EVENT LOG ================= -->
        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="EVENT LOG" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource DimText}" VerticalAlignment="Center">
                            <Run Text="{Binding Logs.Count, Mode=OneWay}"/> <Run Text="건 (최신순)"/>
                        </TextBlock>
                        <Button Style="{StaticResource DarkButton}" Content="지우기" Padding="8,1"
                                Command="{Binding ClearLogCommand}"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource DarkListBox}" ItemsSource="{Binding Logs}"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:LogEntry}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WallTime}" Style="{StaticResource DimText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SimTime}" Style="{StaticResource DimText}"/>
                                <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontWeight="Bold" FontSize="11"
                                           Foreground="{Binding Level, Converter={StaticResource LogBrush}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"
                                           Foreground="{Binding Level, Converter={StaticResource LogBrush}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
