<Window x:Class="AirDefenseC2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Air Defense C2"
        Width="980" Height="720"
        MinWidth="850" MinHeight="650"
        Background="#0E1511"
        Foreground="#D5E8D8"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#14201A"/>
            <Setter Property="BorderBrush" Value="#294335"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- 상단 제목 -->
        <Grid Grid.Row="0">
            <TextBlock Text="AIR DEFENSE C2 · 시뮬레이터"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="● 탐지 5"
                           Foreground="#65E891"
                           Margin="0,0,15,0"/>
                <TextBlock Text="● 경고 2"
                           Foreground="#FFBE45"
                           Margin="0,0,15,0"/>
                <TextBlock Text="● 위협 1"
                           Foreground="#FF6258"/>
            </StackPanel>
        </Grid>

        <!-- 중앙 영역 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 레이더 -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}">

                <Grid>
                    <TextBlock Text="RADAR SCOPE"
                               Foreground="#77BC8B"
                               FontSize="12"
                               VerticalAlignment="Top"/>

                    <Viewbox Stretch="Uniform"
                             Margin="10,30,10,8">

                        <Canvas Width="430" Height="430">

                            <!-- 레이더 원 -->
                            <Ellipse Width="410" Height="410"
                                     Canvas.Left="10" Canvas.Top="10"
                                     Stroke="#28583C"
                                     StrokeThickness="1.5"/>

                            <Ellipse Width="308" Height="308"
                                     Canvas.Left="61" Canvas.Top="61"
                                     Stroke="#28583C"/>

                            <Ellipse Width="205" Height="205"
                                     Canvas.Left="112.5" Canvas.Top="112.5"
                                     Stroke="#28583C"/>

                            <Ellipse Width="102" Height="102"
                                     Canvas.Left="164" Canvas.Top="164"
                                     Stroke="#28583C"/>

                            <!-- 십자선 -->
                            <Line X1="215" Y1="10"
                                  X2="215" Y2="420"
                                  Stroke="#28583C"/>

                            <Line X1="10" Y1="215"
                                  X2="420" Y2="215"
                                  Stroke="#28583C"/>

                            <!-- 레이더 스캔 영역 -->
                            <Path Fill="#183A24"
                                  Opacity="0.7"
                                  Data="M 215,215
                                        L 252,414
                                        A 205,205 0 0 1 152,410
                                        Z"/>

                            <Line X1="215" Y1="215"
                                  X2="258" Y2="415"
                                  Stroke="#5FE18A"
                                  StrokeThickness="2.5"/>

                            <!-- 레이더 중심 -->
                            <Ellipse Width="12" Height="12"
                                     Canvas.Left="209"
                                     Canvas.Top="209"
                                     Fill="#65E891"/>

                            <!-- T-003 드론 -->
                            <Ellipse Width="15" Height="15"
                                     Canvas.Left="118" Canvas.Top="91"
                                     Fill="#FFBE45"/>

                            <TextBlock Text="T-003"
                                       Foreground="#FFBE45"
                                       FontSize="14"
                                       Canvas.Left="138"
                                       Canvas.Top="84"/>

                            <!-- T-007 미사일 -->
                            <Ellipse Width="18" Height="18"
                                     Canvas.Left="286" Canvas.Top="130"
                                     Fill="#FF6258"/>

                            <TextBlock Text="T-007"
                                       Foreground="#FF6258"
                                       FontSize="14"
                                       Canvas.Left="309"
                                       Canvas.Top="123"/>

                            <!-- T-001 항공기 -->
                            <Ellipse Width="12" Height="12"
                                     Canvas.Left="78" Canvas.Top="296"
                                     Fill="#65E891"/>

                            <TextBlock Text="T-001"
                                       Foreground="#65E891"
                                       FontSize="14"
                                       Canvas.Left="95"
                                       Canvas.Top="287"/>

                            <!-- T-011 항공기 -->
                            <Ellipse Width="15" Height="15"
                                     Canvas.Left="339" Canvas.Top="280"
                                     Fill="#FFBE45"/>

                            <TextBlock Text="T-011"
                                       Foreground="#FFBE45"
                                       FontSize="14"
                                       Canvas.Left="286"
                                       Canvas.Top="310"/>

                            <!-- T-009 -->
                            <Ellipse Width="12" Height="12"
                                     Canvas.Left="238" Canvas.Top="355"
                                     Fill="#65E891"/>

                            <TextBlock Text="T-009"
                                       Foreground="#65E891"
                                       FontSize="14"
                                       Canvas.Left="255"
                                       Canvas.Top="349"/>

                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 오른쪽 정보 패널 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 표적 목록 -->
                <Border Grid.Row="0"
                        Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="TARGET LIST"
                                   Foreground="#77BC8B"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ID" Foreground="#739987"/>
                            <TextBlock Grid.Column="1"
                                       Text="종류"
                                       Foreground="#739987"/>
                            <TextBlock Grid.Column="2"
                                       Text="거리"
                                       Foreground="#739987"/>
                            <TextBlock Grid.Column="3"
                                       Text="위험"
                                       Foreground="#739987"/>
                        </Grid>

                        <StackPanel Grid.Row="2">

                            <Border Background="#24372D">
                                <Grid Height="29">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="T-007"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="미사일"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="18km"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="HIGH"
                                               Foreground="#FF6258"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="T-003"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="드론"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="32km"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="MID"
                                           Foreground="#FFBE45"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="T-011"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="항공기"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="41km"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="MID"
                                           Foreground="#FFBE45"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="T-001"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="항공기"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="58km"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="LOW"
                                           Foreground="#65E891"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 요격체계 상태 -->
                <Border Grid.Row="2"
                        Style="{StaticResource PanelStyle}">

                    <StackPanel>
                        <TextBlock Text="WEAPON STATUS"
                                   Foreground="#77BC8B"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="요격체계-1"/>
                            <TextBlock Text="대기 · 8발"
                                       Foreground="#65E891"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="요격체계-2"/>
                            <TextBlock Text="교전 중 · 5발"
                                       Foreground="#FF6258"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="요격체계-3"/>
                            <TextBlock Text="재장전"
                                       Foreground="#FFBE45"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Content="T-007 교전"
                                Height="35"
                                Background="#14201A"
                                Foreground="#FF6258"
                                BorderBrush="#FF6258"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="EngageButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 하단: 교전 로그 -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelStyle}">

            <StackPanel>
                <TextBlock Text="ENGAGEMENT LOG"
                           Foreground="#77BC8B"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="LogText"
                           TextWrapping="Wrap"
                           FontSize="12">
                    <Run Text="[17:50:12] T-007 탐지 → 위험도 HIGH"/>
                    <LineBreak/>
                    <Run Text="[17:50:13] 요격체계-2 할당 → 교전 개시"/>
                    <LineBreak/>
                    <Run Text="[17:50:05] T-003 접근 중 → 위험도 MID"/>
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>
</Window>
