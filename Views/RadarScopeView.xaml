<UserControl x:Class="AirDefenseC2.Views.RadarScopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AirDefenseC2.Controls"
             xmlns:m="clr-namespace:AirDefenseC2.Models">

    <UserControl.Resources>

        <!-- 표적 아이콘 (중심 0,0 / 북쪽을 향하도록 정의 후 Heading 만큼 회전) -->
        <Geometry x:Key="UnknownGeo">M -6,0 A 6,6 0 1 1 6,0 A 6,6 0 1 1 -6,0 Z</Geometry>
        <Geometry x:Key="MissileGeo">M 0,-10 L 5,7 L 0,3.5 L -5,7 Z</Geometry>
        <Geometry x:Key="AircraftGeo">M 0,-10 L 1.6,-6 L 1.6,-2 L 10,3 L 10,5.2 L 1.6,2.6 L 1.2,7 L 4,9 L 4,10.6 L 0,9.6 L -4,10.6 L -4,9 L -1.2,7 L -1.6,2.6 L -10,5.2 L -10,3 L -1.6,-2 L -1.6,-6 Z</Geometry>
        <Geometry x:Key="DroneGeo">M 0,-8 L 8,0 L 0,8 L -8,0 Z M -2,0 A 2,2 0 1 1 2,0 A 2,2 0 1 1 -2,0 Z</Geometry>
        <Geometry x:Key="KillMarkGeo">M -7,-7 L 7,7 M 7,-7 L -7,7</Geometry>

        <!-- 위치 지정 아이템 컨테이너 (km → px) -->
        <Style x:Key="PositionedItem" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource KmToCanvas}, ConverterParameter=X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource KmToCanvas}, ConverterParameter=Y}"/>
        </Style>

        <ItemsPanelTemplate x:Key="CanvasPanel">
            <Canvas/>
        </ItemsPanelTemplate>

        <ControlTemplate x:Key="HitAreaTemplate" TargetType="Button">
            <Ellipse Width="30" Height="30" Fill="Transparent"/>
        </ControlTemplate>

        <!-- ===== 표적 블립 ===== -->
        <DataTemplate x:Key="TargetBlip" DataType="{x:Type m:Target}">
            <Canvas>
                <!-- 선택 강조 -->
                <Canvas Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="40" Height="40" Canvas.Left="-20" Canvas.Top="-20"
                             Stroke="{StaticResource SelectBrush}" StrokeThickness="2" StrokeDashArray="3 2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Path Stroke="{StaticResource SelectBrush}" StrokeThickness="1.5"
                          Data="M -26,-16 L -26,-26 L -16,-26 M 16,-26 L 26,-26 L 26,-16 M 26,16 L 26,26 L 16,26 M -16,26 L -26,26 L -26,16"/>
                </Canvas>

                <!-- 블립 본체 -->
                <Canvas Opacity="{Binding BlipOpacity}">
                    <Line X1="0" Y1="0" X2="{Binding LeaderX}" Y2="{Binding LeaderY}" StrokeThickness="1"
                          Opacity="0.7" Stroke="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>

                    <Path StrokeThickness="1.4">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding Heading}"/>
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource UnknownGeo}"/>
                                <Setter Property="Stroke" Value="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsIdentified}" Value="True"/>
                                            <Condition Binding="{Binding Type}" Value="{x:Static m:TargetType.Missile}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Data" Value="{StaticResource MissileGeo}"/>
                                        <Setter Property="Fill" Value="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsIdentified}" Value="True"/>
                                            <Condition Binding="{Binding Type}" Value="{x:Static m:TargetType.Aircraft}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Data" Value="{StaticResource AircraftGeo}"/>
                                        <Setter Property="Fill" Value="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsIdentified}" Value="True"/>
                                            <Condition Binding="{Binding Type}" Value="{x:Static m:TargetType.Drone}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Data" Value="{StaticResource DroneGeo}"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:TargetStatus.Destroyed}">
                                        <Setter Property="Stroke" Value="#5E7366"/>
                                        <Setter Property="Fill" Value="Transparent"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:TargetStatus.Engaging}">
                                        <Setter Property="StrokeThickness" Value="2.2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- 격추 표시 -->
                    <Path Data="{StaticResource KillMarkGeo}" Stroke="{StaticResource GreenBrush}" StrokeThickness="2">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:TargetStatus.Destroyed}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- 라벨 -->
                    <StackPanel Canvas.Left="12" Canvas.Top="-20" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding Threat, Converter={StaticResource ThreatBrush}}"/>
                        <TextBlock FontSize="9" Foreground="#8FB39C">
                            <Run Text="{Binding TypeName, Mode=OneWay}"/>
                            <Run Text="{Binding StatusText, Mode=OneWay}"
                                 Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        </TextBlock>
                    </StackPanel>
                </Canvas>

                <!-- 클릭 영역 → 표적 선택 -->
                <Button Canvas.Left="-15" Canvas.Top="-15" Focusable="False" Cursor="Hand"
                        Template="{StaticResource HitAreaTemplate}"
                        ToolTip="{Binding Id}"
                        Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Canvas>
        </DataTemplate>

        <!-- ===== 발사대 ===== -->
        <DataTemplate x:Key="LauncherIcon" DataType="{x:Type m:Launcher}">
            <Canvas>
                <Rectangle Width="18" Height="14" Canvas.Left="-9" Canvas.Top="-7"
                           Fill="#12303D" StrokeThickness="1.5"
                           Stroke="{Binding Status, Converter={StaticResource LauncherBrush}}"/>
                <Path Data="M -4,4 L 0,-4 L 4,4 Z" Fill="{StaticResource FriendlyBrush}"/>
                <TextBlock Canvas.Left="12" Canvas.Top="-8" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource FriendlyBrush}">
                    <Run Text="{Binding Id, Mode=OneWay}"/>
                    <Run Text="{Binding AmmoText, Mode=OneWay}" FontWeight="Normal" FontSize="9"
                         Foreground="{Binding Status, Converter={StaticResource LauncherBrush}}"/>
                </TextBlock>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="LauncherRange" DataType="{x:Type m:Launcher}">
            <Canvas>
                <Ellipse Width="{Binding RangeDiameterPx}" Height="{Binding RangeDiameterPx}"
                         Canvas.Left="{Binding RangeOffsetPx}" Canvas.Top="{Binding RangeOffsetPx}"
                         Stroke="{StaticResource FriendlyBrush}" StrokeThickness="0.8"
                         StrokeDashArray="2 4" Opacity="0.35"/>
            </Canvas>
        </DataTemplate>

        <!-- ===== 요격 미사일 ===== -->
        <DataTemplate x:Key="InterceptorIcon" DataType="{x:Type m:Interceptor}">
            <Canvas Visibility="{Binding IsLaunched, Converter={StaticResource BoolToVis}}">
                <Ellipse Width="12" Height="12" Canvas.Left="-6" Canvas.Top="-6"
                         Stroke="{StaticResource FriendlyBrush}" StrokeThickness="1" Opacity="0.6"/>
                <Ellipse Width="6" Height="6" Canvas.Left="-3" Canvas.Top="-3" Fill="White"/>
                <TextBlock Text="{Binding Id}" Canvas.Left="8" Canvas.Top="2" FontSize="9"
                           Foreground="{StaticResource FriendlyBrush}"/>
            </Canvas>
        </DataTemplate>

        <!-- ===== 폭발 ===== -->
        <DataTemplate x:Key="ExplosionFx" DataType="{x:Type m:Explosion}">
            <Canvas Opacity="{Binding Opacity}">
                <Ellipse Width="40" Height="40" Canvas.Left="-20" Canvas.Top="-20" StrokeThickness="2">
                    <Ellipse.RenderTransform>
                        <ScaleTransform CenterX="20" CenterY="20" ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Stroke" Value="#FF9A3C"/>
                            <Setter Property="Fill">
                                <Setter.Value>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#C0FFD27A" Offset="0"/>
                                        <GradientStop Color="#60FF7A2A" Offset="0.6"/>
                                        <GradientStop Color="#00FF5A1A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:ExplosionKind.Miss}">
                                    <Setter Property="Stroke" Value="#9FB4A8"/>
                                    <Setter Property="Fill" Value="#209FB4A8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:ExplosionKind.Impact}">
                                    <Setter Property="Stroke" Value="#FF3B30"/>
                                    <Setter Property="Fill" Value="#60FF3B30"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="640" Height="640" ClipToBounds="True">

            <!-- 배경: 탐색 영역 / 동심원 / 방위선 -->
            <c:RadarGrid IsHitTestVisible="False"/>

            <!-- 레이더 스캔 빔 -->
            <c:RadarSweep IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <c:RadarSweep.RenderTransform>
                    <RotateTransform Angle="{Binding SweepAngle}"/>
                </c:RadarSweep.RenderTransform>
            </c:RadarSweep>

            <!-- 발사대 교전 반경 -->
            <ItemsControl ItemsSource="{Binding Launchers}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}"
                          ItemContainerStyle="{StaticResource PositionedItem}"
                          ItemTemplate="{StaticResource LauncherRange}"/>

            <!-- 표적 항적 -->
            <ItemsControl ItemsSource="{Binding Targets}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Target}">
                        <Polyline Points="{Binding Trail, Converter={StaticResource TrailToPoints}}"
                                  Stroke="{Binding Threat, Converter={StaticResource ThreatBrush}}"
                                  StrokeThickness="1" StrokeDashArray="1 2" Opacity="0.55"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 요격 미사일 궤적 -->
            <ItemsControl ItemsSource="{Binding Interceptors}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Interceptor}">
                        <Polyline Points="{Binding Trail, Converter={StaticResource TrailToPoints}}"
                                  Stroke="{StaticResource FriendlyBrush}" StrokeThickness="1.2" Opacity="0.7"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 방어 지역 (레이더 중심) -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="15" Height="15" Canvas.Left="312.5" Canvas.Top="312.5"
                         Stroke="{StaticResource GreenBrush}" StrokeThickness="1" StrokeDashArray="2 2"/>
                <Path Data="M 320,315 L 325,320 L 320,325 L 315,320 Z" Fill="{StaticResource GreenBrush}"/>
                <TextBlock Text="HQ" Canvas.Left="328" Canvas.Top="322" FontSize="9" Foreground="{StaticResource GreenBrush}"/>
            </Canvas>

            <!-- 발사대 -->
            <ItemsControl ItemsSource="{Binding Launchers}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}"
                          ItemContainerStyle="{StaticResource PositionedItem}"
                          ItemTemplate="{StaticResource LauncherIcon}"/>

            <!-- 표적 -->
            <ItemsControl ItemsSource="{Binding Targets}"
                          ItemsPanel="{StaticResource CanvasPanel}"
                          ItemContainerStyle="{StaticResource PositionedItem}"
                          ItemTemplate="{StaticResource TargetBlip}"/>

            <!-- 요격 미사일 -->
            <ItemsControl ItemsSource="{Binding Interceptors}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}"
                          ItemContainerStyle="{StaticResource PositionedItem}"
                          ItemTemplate="{StaticResource InterceptorIcon}"/>

            <!-- 폭발 효과 -->
            <ItemsControl ItemsSource="{Binding Explosions}" IsHitTestVisible="False"
                          ItemsPanel="{StaticResource CanvasPanel}"
                          ItemContainerStyle="{StaticResource PositionedItem}"
                          ItemTemplate="{StaticResource ExplosionFx}"/>
        </Grid>
    </Viewbox>
</UserControl>
